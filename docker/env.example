# ============================================
# Docker Compose 环境变量配置文件
# 复制此文件为 .env 并修改相应的值
# ============================================

# ==================== MySQL 数据库配置 ====================
# MySQL root 密码（必须修改）
MYSQL_ROOT_PASSWORD=your_strong_mysql_password_here

# 数据库名称
MYSQL_DATABASE=dify_workflow_config

# 数据库用户名（默认使用root）
MYSQL_USERNAME=root

# MySQL 暴露端口（主机端口，避免与本地MySQL冲突）
MYSQL_PORT=13306

# ==================== JWT 认证配置 ====================
# JWT 密钥（必须修改为随机字符串）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=1780a4a2690cabc61de442868accec54a6a37f3cb6014e173523498bde366d29

# Token 过期时间（天）
JWT_EXPIRES_DAYS=7

# Token 签发者
JWT_ISSUER=dify-workflow-exporter

# Token 加密算法
JWT_ALGORITHM=HS256

# ==================== 应用配置 ====================
# 应用对外暴露端口（前端访问端口）
APP_PORT=80

# Flask 后端端口（内部端口，无需修改）
FLASK_PORT=5001

# Flask 调试模式（生产环境请设置为 false）
FLASK_DEBUG=false

# ==================== Gunicorn 配置 ====================
# Gunicorn Worker 进程数（建议: CPU核心数 * 2 + 1）
GUNICORN_WORKERS=4

# Gunicorn 超时时间（秒）
GUNICORN_TIMEOUT=120

# ==================== 日志配置 ====================
# 日志级别: debug, info, warning, error, critical
LOG_LEVEL=info

